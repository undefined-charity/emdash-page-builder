---
/**
 * Render a builder document — and, for a signed-in editor in edit mode, make
 * it editable in place.
 *
 * Visitors get plain server-rendered HTML (no JavaScript). Editors get the same
 * HTML plus the editor island, which takes over that markup: blocks the site
 * renders itself (forms, next-event panels…) are wrapped so the editor can lift
 * their live preview out of the page.
 *
 *   <PageBuilder value={entry.data.body} entry={{ collection: 'pages', id: entry.data.id }}
 *     config={builderConfig} components={{ 'site.nextEvent': NextEvent }} theme={entry.data.theme} />
 */
import { getEmDashEntry, getRequestContext } from "emdash";
import { PortableText } from "emdash/ui";

import { renderDocument } from "../render/html.js";
import { resolveConfig, type BuilderConfig } from "../schema/config.js";
import { ANIMATION_SCRIPT } from "../schema/animation.js";
import { BACKGROUND_KEY, cleanPageBackground, pageBackgroundCss, pageBackgroundVideo } from "../schema/background.js";
import { responsiveCss, themeToCss } from "../schema/style.js";
import EditorIsland from "../editor/EditorIsland.tsx";
import { loadSite } from "./site.js";
import "../styles/page-builder.css";

interface Props {
	value: unknown;
	/** The entry holding `value`. Omit to render read-only. */
	/** `themeField: null` for a collection without per-page design. */
	entry?: { collection: string; id: string; field?: string; themeField?: string | null; title?: string };
	config?: Partial<BuilderConfig>;
	/** Astro components for external block types, keyed by Portable Text `_type`. */
	components?: Record<string, unknown>;
	/** Per-page theme overrides (CSS custom properties). */
	theme?: unknown;
	/** Set when rendering inside another builder document (reusable blocks). */
	nested?: boolean;
	/**
	 * Name of a site region (e.g. "Site header") when this document is shared
	 * by every page. Editable in place like the page, and labelled as shared.
	 */
	region?: string;
	/**
	 * Rendered inside a block of another editable document (e.g. an event's
	 * content inside the event template). Editable in place too: the outer
	 * editor mounts this document's editor inside its block.
	 */
	embedded?: boolean;
	class?: string;
}

const { entry, config: partial, components = {}, nested = false, region, embedded = false, class: className } = Astro.props;
let { value, theme } = Astro.props;
const config = resolveConfig(partial);

const EDITOR_ROLE = 30;
const role = (Astro.locals as { user?: { role?: number } }).user?.role ?? 0;
// `?pb-preview`: the editor's Preview. Edit mode serves every entry's latest
// draft; this renders them as a visitor sees them, with no editor.
const previewing = Astro.url.searchParams.has("pb-preview");
// `?pb-preview&pb-revision=<id>`: an earlier version of this document, from
// the editor's History (editors only).
const revisionId = previewing ? Astro.url.searchParams.get("pb-revision") : null;
if (revisionId && entry && !nested && role >= EDITOR_ROLE) {
	const emdash = (Astro.locals as { emdash?: { handleRevisionGet?: (id: string) => Promise<{ success: boolean; data?: { item?: { collection: string; entryId: string; data: Record<string, unknown> } } }> } }).emdash;
	const rev = await emdash?.handleRevisionGet?.(revisionId).catch(() => null);
	const item = rev?.success ? rev.data?.item : undefined;
	if (item && item.collection === entry.collection && item.entryId === entry.id) {
		value = item.data[entry.field ?? "body"];
		const themeField = entry.themeField === null ? null : (entry.themeField ?? "theme");
		if (themeField) theme = item.data[themeField];
	}
}
const { parts, slots } = renderDocument(value, config);
/** A site block hidden on a screen or animated gets a wrapper to carry that. */
const wrapped = (slot: (typeof slots)[number]) => Boolean(slot.hide || Object.keys(slot.anim ?? {}).length);
const editing = !nested && !previewing && Boolean(entry) && role >= EDITOR_ROLE && Boolean(getRequestContext()?.editMode);
// The entrance-animation script, only on pages that have animated blocks
// (never while editing: blocks don't animate in the editor).
const animated = !editing && JSON.stringify(value ?? null).includes('"pbAnim"');

// Reusable blocks are entries in their own collection; fetch each once.
const reusable = new Map<string, { title: string; content: unknown; id: string } | null>();
for (const slot of slots) {
	if (slot.kind !== "reusable" || !slot.ref || reusable.has(slot.ref)) continue;
	try {
		const { entry: shared } = await getEmDashEntry(config.reusableCollection, slot.ref);
		const data = shared?.data as { id?: string; title?: string; content?: unknown } | undefined;
		reusable.set(slot.ref, data ? { title: data.title ?? slot.title, content: data.content, id: data.id ?? slot.ref } : null);
	} catch {
		reusable.set(slot.ref, null);
	}
}

const themeCss = nested || region || embedded ? undefined : themeToCss(theme, config.themeTokens);
// The page's own document (not a header, footer or embedded one) carries the page-wide extras.
const pageDoc = !nested && !region && !embedded;
const site = pageDoc ? await loadSite(Astro) : undefined;
const backToTop = site?.settings.backToTop;
// The page's own background, or the site's default.
const background = site ? (cleanPageBackground((theme as Record<string, unknown> | null | undefined)?.[BACKGROUND_KEY]) ?? site.settings.background) : undefined;
const backgroundCss = pageBackgroundCss(background, config.phoneBreakpoint);
const backgroundVideo = pageBackgroundVideo(background);
const rootId = entry ? `pb-${entry.collection}-${entry.id}-${entry.field ?? "body"}` : undefined;
const Self = Astro.self;
const islandProps =
	editing && entry
		? {
				rootId: rootId!,
				value: Array.isArray(value) ? value : [],
				collection: entry.collection,
				entryId: entry.id,
				field: entry.field ?? "body",
				themeField: entry.themeField === null ? "" : (entry.themeField ?? "theme"),
				title: entry.title ?? "",
				theme: theme ?? null,
				config,
				reusableTitles: Object.fromEntries([...reusable].map(([ref, v]) => [ref, v?.title ?? ""])),
				region,
			}
		: null;
---

{themeCss && <style set:html={themeCss} data-pb-theme />}
{!nested && <style set:html={responsiveCss(config.phoneBreakpoint)} data-pb-responsive />}
{backgroundCss && <style set:html={backgroundCss} data-pb-page-bg-css />}
{backgroundVideo && (
	<div class="pb-page-bg" data-pb-page-bg aria-hidden="true">
		<video src={backgroundVideo.src} poster={backgroundVideo.poster} autoplay muted loop playsinline preload="auto"></video>
	</div>
)}
<div
	class:list={["pb-doc", className]}
	data-pb-root={rootId}
	data-pb-editing={editing ? "" : undefined}
	data-pb-embed={embedded && islandProps ? JSON.stringify(islandProps) : undefined}
>
	{parts.map((html, i) => {
		const slot = slots[i];
		const shared = slot?.kind === "reusable" ? reusable.get(slot.ref) : undefined;
		return (
			<>
				<Fragment set:html={html} />
				{slot?.kind === "external" && (editing ? (
					<div class="pb-slot" data-pb-slot={slot.key}>
						<PortableText value={[slot.block]} components={{ type: components }} />
					</div>
				) : wrapped(slot) ? (
					<div class={slot.hide ? `pb-hide-${slot.hide}` : undefined} {...slot.anim}>
						<PortableText value={[slot.block]} components={{ type: components }} />
					</div>
				) : (
					<PortableText value={[slot.block]} components={{ type: components }} />
				))}
				{slot?.kind === "reusable" && (editing ? (
					<div class="pb-slot" data-pb-slot={slot.key}>
						{shared && <Self value={shared.content} config={partial} components={components} nested />}
					</div>
				) : wrapped(slot) ? (
					<div class={slot.hide ? `pb-hide-${slot.hide}` : undefined} {...slot.anim}>
						{shared && <Self value={shared.content} config={partial} components={components} nested />}
					</div>
				) : (
					shared && <Self value={shared.content} config={partial} components={components} nested />
				))}
			</>
		);
	})}
</div>

{previewing && pageDoc && <style set:html="#emdash-toolbar { display: none !important; }" data-pb-preview />}

{animated && <script is:inline set:html={ANIMATION_SCRIPT} />}

{backToTop && (
	<a href="#" class="pb-back-to-top" aria-label="Back to top" title="Back to top">
		<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 5l-7 7m7-7l7 7M12 5v14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
	</a>
)}

{islandProps && !embedded && <EditorIsland client:only="react" {...islandProps} />}
